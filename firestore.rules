rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- users/{userId} ---
    // Read must stay open to any signed-in user (not just the owner)
    // because friend search, email lookup, and contact-hash matching
    // all query across other users' documents. Write stays owner-only.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /friends/{friendId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /travelGroups/{groupId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /ritualCompletions/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // --- presence/{uid} ---
    // Foreground "I'm nearby" toggle.
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // --- pings/{pingId} ---
    // 1:1 messages (Nearby tab + group invite notifications).
    match /pings/{pingId} {
      allow read: if request.auth != null &&
        (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUserId;
      allow update: if request.auth != null && request.auth.uid == resource.data.toUserId;
    }

    // --- trips/{tripId} ---
    // Saved trips (Account page, fare monitoring). Private to the owner.
    match /trips/{tripId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // --- groupTrips/{tripId} ---
    // Real multi-person trip hub.
    match /groupTrips/{tripId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid in resource.data.memberIds;

      match /posts/{postId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null;
      }

      match /locations/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /messages/{messageId} {
        allow read, create: if request.auth != null;
      }
    }

    // --- sharedTrips/{id} ---
    // Public read-only trip snapshots powering /trip/:id — anyone with
    // the link can view, no sign-in required, matching the app's
    // "search and link out, no accounts needed to browse" model.
    // Create is left open (no auth required) since guests use "Share
    // this trip" without signing in — but update/delete are blocked
    // entirely, so existing shared links can never be tampered with.
    match /sharedTrips/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // No catch-all. Any collection not explicitly listed above is
    // now fully locked down by default — if you add a new feature
    // with a new collection, you must add a rule for it here first
    // or it simply won't work (fails closed, not open).
  }
}
