# --- Frontend (put in a file named .env.local in the project root) ---
# Leave these blank to run the app in demo mode (fully clickable, sign-in
# is stubbed with a clear message). Fill them in once you've created a
# Firebase project to enable real Google/Apple/Yahoo sign-in and saved trips.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=http://localhost:4000

# --- Backend (put in a file named .env inside /server) ---
# Leave DUFFEL_API_KEY blank to run flight search in demo mode with
# realistic mock fares. Add a free test key from duffel.com for live data.
DUFFEL_API_KEY=
PORT=4000
